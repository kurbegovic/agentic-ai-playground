{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  },
  "extensions": {
    "http": { "routePrefix": "" }
  },
  "customHandler": {
    "description": {
      "defaultExecutablePath": "python",
      "arguments": ["server.py", "web"]
    },
    "enableForwardingHttpRequest": true
  }
}